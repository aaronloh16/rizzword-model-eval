# ─────────────────────────────────────────────────────────────────────────────
# RizzWord environment
#
# Nothing here is required. With no env at all the site runs in replay mode:
# visitors watch committed race transcripts and solve puzzles, $0 in API spend.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical URL for metadata / OG / sitemap. Defaults to the Vercel production
# URL, then https://rizzword.vercel.app.
# NEXT_PUBLIC_SITE_URL=https://rizzword.vercel.app

# ── Live racing (costs money) ───────────────────────────────────────────────
# Master switch. Live races only run when this is exactly "true".
LIVE_RACES_ENABLED=false

# Vercel AI Gateway key (https://vercel.com/d?to=/[team]/~/ai-gateway/api-keys).
# On Vercel you can skip this: deployments get an OIDC token automatically.
# Tip: give this key its own budget in the AI Gateway dashboard as a hard backstop.
AI_GATEWAY_API_KEY=

# Optional shared secret. If set, the Live page asks for it before racing.
# In production, live racing requires this OR Redis below (fails closed).
LIVE_RACE_ACCESS_CODE=

# Cost & abuse guards (defaults shown).
# Max worst-case cost of a single race, in USD. Lineups above this are refused.
LIVE_RACE_MAX_USD=0.25
# Per-IP races per hour (needs Redis).
LIVE_RACE_PER_IP_PER_HOUR=3
# Global races per UTC day (needs Redis).
LIVE_RACE_DAILY_LIMIT=40
# Global spend per UTC day in USD; worst case is reserved up front (needs Redis).
LIVE_RACE_DAILY_BUDGET_USD=5

# ── Redis (rate limits, daily caps, crowd predictions) ─────────────────────
# Either Upstash directly…
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# …or the Vercel KV / Upstash Marketplace integration names.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
